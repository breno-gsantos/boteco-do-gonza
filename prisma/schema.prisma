generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Account{
  id               String @id @default(cuid())
  clerkId          String @unique
  email            String 
  name             String
  role             Role @default(ADMIN)

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("accounts")
}

model Reservation{
  id               String @id @default(cuid())
  name             String
  whatsapp         String
  date             DateTime
  time             String
  guests           Int
  status           ReservationStatus @default(PENDING)
  notes            String?
  tableNumber      Int?

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("reservations")
  @@index([date])
  @@index([date, time])
}

model Category{
  id               String @id @default(cuid())
  name             String @unique
  slug             String @unique
  order            Int @default(0)
  isActive         Boolean @default(true)

  type             String @default("food")

  items            MenuItem[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("categories")
}

model MenuItem {
  id          String   @id @default(cuid())
  name        String
  description String?
  price       Int  
  imageUrl    String?
  isAvailable Boolean  @default(true)
  isFeatured  Boolean  @default(false)
  order       Int      @default(0)

  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("menu_items")
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  CANCELLED
  NO_SHOW
}

model OperatingHour {
  id        String   @id @default(cuid())
  dayOfWeek Int      // 0 = Domingo, 6 = Sábado
  time      String   // "19:00"
  isActive  Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([dayOfWeek, time])
  @@map("operating_hours")
}

model BlockedSlot {
  id        String   @id @default(cuid())
  date      DateTime // data específica (yyyy-mm-dd)
  time      String   // "19:30"
  reason    String?  // opcional: "Feriado", "Evento", etc.

  createdAt DateTime @default(now())

  @@unique([date, time])
  @@map("blocked_slots")
}

enum Role {
  ADMIN
  STAFF
}
